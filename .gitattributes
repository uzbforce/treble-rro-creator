# Keep one working tree valid on Linux, Termux and Windows.
#
# The bash scripts and the files build.sh generates are executed by Android's
# /sbin/sh at install/boot time, which fails on CRLF line endings. Git for
# Windows defaults to core.autocrlf=true, so pin the line endings explicitly.

* text=auto

# Shell + data files that must stay LF
*.sh      text eol=lf
*.go      text eol=lf
*.env     text eol=lf
*.example text eol=lf
*.rule    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.prop    text eol=lf
*.mk      text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows launchers must be CRLF (cmd.exe mis-parses LF-only batch files)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.apk binary
*.zip binary
*.pk8 binary
*.pem binary
